.root {
    flex-grow: 1;
    padding: 14px;
}

.header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.header-icon {
    width: 32px;
    height: 32px;
    margin-right: 10px;
}

.title {
    -unity-font-style: bold;
    font-size: 17px;
}

.subtitle, .asset-path {
    opacity: 0.65;
}

.subtitle {
    white-space: normal;
}

.settings {
    margin-bottom: 8px;
}

.settings IntegerField, .settings FloatField {
    margin-top: 4px;
}

.link-button {
    align-self: flex-end;
    margin-top: 5px;
}

.scan-button {
    height: 32px;
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.status-row {
    flex-direction: row;
    align-items: center;
    padding: 8px 10px;
    margin-bottom: 10px;
    border-width: 1px;
    border-radius: 4px;
    border-color: rgba(128, 128, 128, 0.35);
}

.total-count {
    min-width: 24px;
    -unity-font-style: bold;
    font-size: 15px;
}

.status-label {
    white-space: normal;
    flex-grow: 1;
}

.summary {
    flex-direction: row;
    flex-wrap: wrap;
    margin: 0 -3px 10px -3px;
}

.summary-card {
    width: 45%;
    min-width: 145px;
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    padding: 7px;
    margin: 3px;
    border-width: 1px;
    border-radius: 4px;
    border-color: rgba(128, 128, 128, 0.35);
}

.summary-card--muted {
    opacity: 0.5;
}

.summary-card Label {
    margin-right: 5px;
}

.summary-icon {
    width: 18px;
    height: 18px;
    margin-right: 6px;
}

.results-toolbar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
}

.section-title {
    -unity-font-style: bold;
    font-size: 14px;
}

.results-toolbar DropdownField {
    min-width: 190px;
}

.empty-state {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    min-height: 130px;
    opacity: 0.7;
}

.results {
    flex-grow: 1;
}

.result-group {
    margin-bottom: 5px;
    -unity-font-style: bold;
}

.result-row {
    flex-direction: row;
    align-items: center;
    padding: 8px;
    margin: 3px 0 3px 14px;
    border-left-width: 2px;
    border-color: rgba(128, 128, 128, 0.45);
}

.result-row:hover {
    background-color: rgba(128, 128, 128, 0.12);
}

.result-row > Image {
    width: 20px;
    height: 20px;
    margin-right: 8px;
}

.result-copy {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.result-copy Label {
    white-space: normal;
}

.asset-path {
    font-size: 10px;
    margin-top: 2px;
}

.ping-button {
    width: 54px;
    flex-shrink: 0;
    margin-left: 8px;
}
